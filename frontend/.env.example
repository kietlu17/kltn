# Optional: absolute API base URL.
# Required when frontend is opened from a domain.
# Use HTTPS if the frontend domain is HTTPS, otherwise the browser may block the request as mixed content.
# VITE_API_BASE_URL=https://api.example.com

# Used by Vite dev server proxy (frontend -> api-gateway)
VITE_API_GATEWAY_URL=http://localhost:3000

# Socket.IO realtime endpoint.
# In local dev, this should point directly to api-gateway to avoid Vite websocket proxy resets.
VITE_REALTIME_BASE_URL=http://localhost:3000

# Used by Vite dev server proxy (frontend /livekit -> LiveKit signaling)
VITE_LIVEKIT_URL=http://localhost:7880

# Product images are loaded directly from MinIO, not through api-gateway.
VITE_PRODUCT_IMAGE_BASE_URL=http://localhost:9000/product-images
