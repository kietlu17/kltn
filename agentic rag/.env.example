GEMINI_API_KEY=
AGENTIC_GEMINI_MODEL=gemini-3.5-flash-lite
# Chat model provider: gemini | openai (any OpenAI-compatible gateway).
# Embeddings always use Gemini, so switching does not require re-indexing.
AGENTIC_LLM_PROVIDER=gemini
AGENTIC_LLM_BASE_URL=
AGENTIC_LLM_MODEL=
AGENTIC_LLM_API_KEY=
AGENTIC_REASONING_EFFORT=none
AGENTIC_EMBEDDING_MODEL=gemini-embedding-001
AGENTIC_EMBEDDING_DIMENSIONS=768
AGENTIC_SEMANTIC_DECISION_V2=true
AGENTIC_THINKING_LEVEL=minimal

# Per-turn budget: at most this many generative calls and this much wall time.
AGENTIC_MAX_LLM_CALLS=4
AGENTIC_TURN_DEADLINE_SECONDS=8
AGENTIC_DECIDE_TIMEOUT_SECONDS=4
AGENTIC_DECIDE_HEDGE_SECONDS=1.5
AGENTIC_VERIFY_TIMEOUT_SECONDS=3
AGENTIC_ANSWER_TIMEOUT_SECONDS=4
AGENTIC_EMBED_TIMEOUT_SECONDS=3

# Leave empty to use the collection built by app.indexer (agentic-v1, hybrid).
# Set it to chatbot-service's catalog_* collection to fall back to dense-only v4.
AGENTIC_QDRANT_COLLECTION=

# Embedding worker (python -m app.indexer). A non-empty key file wins over
# GEMINI_API_KEY and is re-read before every batch.
GEMINI_API_KEY_FILE=./secrets/gemini_api_key
INDEXER_BATCH_SIZE=50
INDEXER_MODE=watch
INDEXER_INTERVAL_SECONDS=900
INDEXER_BATCH_INTERVAL_SECONDS=0
# Each batch goes out as requests of INDEXER_REQUEST_SIZE texts spaced
# INDEXER_REQUEST_INTERVAL_SECONDS apart; failed parts retry after INDEXER_RETRY_SECONDS.
INDEXER_REQUEST_SIZE=10
INDEXER_REQUEST_INTERVAL_SECONDS=12
INDEXER_RETRY_SECONDS=60
# 0 = unlimited; caps provider batches per cycle to protect the daily quota.
INDEXER_MAX_BATCHES=0
QDRANT_URL=http://localhost:6333

PRODUCT_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3007
REVIEW_SERVICE_URL=http://localhost:3008
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
VOUCHER_SERVICE_URL=http://localhost:3013
USER_SERVICE_URL=http://localhost:3002

AGENTIC_DATA_DIR=./data
AGENTIC_SESSION_TTL_SECONDS=86400
AGENTIC_ACTION_TTL_SECONDS=600
AGENTIC_RETRIEVAL_LIMIT=30
AGENTIC_RESULT_LIMIT=6
AGENTIC_MIN_SCORE=0.35
AGENTIC_MAX_RETRIEVAL_ROUNDS=2

# Enable these inside the existing mTLS docker network.
MTLS_ENABLED=false
MTLS_CA_PATH=/certs/ca/ca.crt
MTLS_CLIENT_CERT_PATH=/certs/chatbot-service/tls.crt
MTLS_CLIENT_KEY_PATH=/certs/chatbot-service/tls.key

