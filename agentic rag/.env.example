GEMINI_API_KEY=
AGENTIC_GEMINI_MODEL=gemini-3.5-flash-lite
# Chat model provider: gemini | openai (any OpenAI-compatible gateway).
# Embeddings always use Gemini, so switching does not require re-indexing.
AGENTIC_LLM_PROVIDER=gemini
AGENTIC_LLM_BASE_URL=
AGENTIC_LLM_MODEL=
AGENTIC_LLM_API_KEY=
AGENTIC_REASONING_EFFORT=none
# Optional stronger model for turn understanding (plan) on the same gateway;
# answers, ranking and order resolution keep AGENTIC_LLM_MODEL.
AGENTIC_DECIDE_MODEL=
AGENTIC_DECIDE_REASONING_EFFORT=
AGENTIC_DECIDE_TIMEOUT_SECONDS=4
# With AGENTIC_DECIDE_MODEL set: seconds before the chat model is asked too
# (capped at 60% of the decide timeout so both can still answer).
AGENTIC_DECIDE_FALLBACK_AFTER_SECONDS=2.5
# The model that writes the reply the customer reads (one call per turn). A
# stronger model here (e.g. a Flash model instead of Flash-Lite) is what makes
# the assistant sound like a real chat; empty = AGENTIC_GEMINI_MODEL.
AGENTIC_ANSWER_MODEL=
AGENTIC_ANSWER_TEMPERATURE=1.0
# Messages (user + assistant) of the conversation the reply model reads.
AGENTIC_ANSWER_HISTORY_MESSAGES=16
# Session memory: the transcript grows to MAX messages, then the oldest are
# folded into a rolling summary (one background call) until KEEP remain.
AGENTIC_HISTORY_KEEP_MESSAGES=12
AGENTIC_HISTORY_MAX_MESSAGES=20
AGENTIC_SUMMARY_ENABLED=true
AGENTIC_SUMMARY_TIMEOUT_SECONDS=15
AGENTIC_EMBEDDING_MODEL=gemini-embedding-001
AGENTIC_EMBEDDING_DIMENSIONS=768
AGENTIC_SEMANTIC_DECISION_V2=true
AGENTIC_THINKING_LEVEL=minimal

# LLM-first: the model decides, ranks and answers every turn; rule parsers,
# the fast path and template answers only back it up. false = latency-first.
AGENTIC_LLM_FIRST=true

# Per-turn budget: at most this many generative calls and this much wall time.
# A turn typically uses decide + rank + answer; web search and the order
# agent's resolver add one each in the cases that need them.
AGENTIC_MAX_LLM_CALLS=6
AGENTIC_TURN_DEADLINE_SECONDS=15
AGENTIC_DECIDE_TIMEOUT_SECONDS=4
AGENTIC_DECIDE_HEDGE_SECONDS=1.5
AGENTIC_VERIFY_TIMEOUT_SECONDS=3
AGENTIC_ANSWER_TIMEOUT_SECONDS=8
AGENTIC_EMBED_TIMEOUT_SECONDS=3

# Leave empty to use the collection built by app.indexer (agentic-v1, hybrid).
# Set it to chatbot-service's catalog_* collection to fall back to dense-only v4.
AGENTIC_QDRANT_COLLECTION=

# Embedding worker (python -m app.indexer). A non-empty key file wins over
# GEMINI_API_KEY and is re-read before every batch.
GEMINI_API_KEY_FILE=./secrets/gemini_api_key
INDEXER_BATCH_SIZE=50
INDEXER_MODE=watch
INDEXER_INTERVAL_SECONDS=900
INDEXER_BATCH_INTERVAL_SECONDS=0
# Each batch goes out as requests of INDEXER_REQUEST_SIZE texts spaced
# INDEXER_REQUEST_INTERVAL_SECONDS apart; failed parts retry after INDEXER_RETRY_SECONDS.
INDEXER_REQUEST_SIZE=10
INDEXER_REQUEST_INTERVAL_SECONDS=12
INDEXER_RETRY_SECONDS=60
# 0 = unlimited; caps provider batches per cycle to protect the daily quota.
INDEXER_MAX_BATCHES=0
QDRANT_URL=http://localhost:6333

PRODUCT_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3007
REVIEW_SERVICE_URL=http://localhost:3008
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
VOUCHER_SERVICE_URL=http://localhost:3013
USER_SERVICE_URL=http://localhost:3002

AGENTIC_DATA_DIR=./data
AGENTIC_SESSION_TTL_SECONDS=86400
AGENTIC_ACTION_TTL_SECONDS=600
AGENTIC_RETRIEVAL_LIMIT=30
AGENTIC_RESULT_LIMIT=6
AGENTIC_MIN_SCORE=0.35
AGENTIC_MAX_RETRIEVAL_ROUNDS=2

# Enable these inside the existing mTLS docker network.
MTLS_ENABLED=false
MTLS_CA_PATH=/certs/ca/ca.crt
MTLS_CLIENT_CERT_PATH=/certs/chatbot-service/tls.crt
MTLS_CLIENT_KEY_PATH=/certs/chatbot-service/tls.key

# Product agent web search (Gemini grounded Google Search, always the Gemini
# key) for knowledge questions and searches the catalog cannot answer.
AGENTIC_WEB_SEARCH=true
AGENTIC_WEB_SEARCH_MODEL=
AGENTIC_WEB_SEARCH_TIMEOUT_SECONDS=7

# Ranking: hybrid search -> cross-encoder pre-sort (AGENTIC_RERANK_CANDIDATES)
# -> LLM judge on the best AGENTIC_LLM_RERANK_CANDIDATES, which decides the
# top-k (at most AGENTIC_RESULT_LIMIT). Modes: llm | cross_encoder | off.
# Without the judge, the cross-encoder probability is blended with the hybrid
# rank (AGENTIC_RERANK_WEIGHT) and candidates below
# AGENTIC_RERANK_RELATIVE_CUTOFF x best score are not shown.
AGENTIC_RESULT_LIMIT=5
AGENTIC_RERANK_MODE=llm
AGENTIC_RERANK=true
AGENTIC_RERANK_CANDIDATES=20
AGENTIC_RERANK_TIMEOUT_SECONDS=2
AGENTIC_LLM_RERANK_CANDIDATES=10
AGENTIC_RANK_TIMEOUT_SECONDS=4
AGENTIC_RERANK_WEIGHT=0.75
AGENTIC_RERANK_RELATIVE_CUTOFF=0.3
# Local model server (CLIP /embed + cross-encoder /rerank): the image-embedding
# service of the main docker-compose.yml.
AGENTIC_MODEL_SERVER_URL=http://image-embedding:3022
# Photo search over the CLIP collection built by chatbot-image-indexer.
AGENTIC_IMAGE_MIN_SCORE=0.65
AGENTIC_IMAGE_TIMEOUT_SECONDS=10


# Hybrid mode: advice turns (search, compare, multi-part questions) run on a
# tool-calling advisor; cart, checkout, orders and policy stay on the graph.
# graph = fixed pipeline for every turn. A failed advisor turn falls back.
AGENTIC_MODE=graph
# Tool-calling model of the advisor; empty = AGENTIC_ANSWER_MODEL.
AGENTIC_ADVISOR_MODEL=
AGENTIC_ADVISOR_MAX_STEPS=4
AGENTIC_ADVISOR_STEP_TIMEOUT_SECONDS=12
