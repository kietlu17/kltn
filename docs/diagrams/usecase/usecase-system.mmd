  theme: base
  themeCSS: ".usecase-actor .usecase-actor-stick { stroke: #222 !important; fill: #fff !important; stroke-width: 1.5px !important; } .usecase-actor.admin .usecase-actor-stick { stroke: #A0574A !important; fill: #E8C9C2 !important; } .usecase-actor.sys .usecase-actor-stick { stroke: #555 !important; fill: #eee !important; } .usecase-ellipse .label-container { fill: #FCF3CF !important; stroke: #B8A060 !important; stroke-width: 1px !important; } .usecase-system-boundary .boundary-body, .usecase-system-boundary rect, .usecase-system-boundary path { fill: #fff !important; stroke: #222 !important; stroke-width: 1px !important; filter: none !important; } .system-boundary-title, .system-boundary-title * { font-family: Source Sans Pro, Segoe UI, Arial, sans-serif !important; } .relationship-association, .relationship-generalization { stroke: #333 !important; stroke-width: 1px !important; }"
  themeVariables:
