CHATBOT_EMBEDDING_MODEL=gemini-embedding-001
# Gemini handles planning, answers, image understanding and text embeddings.
CHATBOT_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
CHATBOT_WHISPER_MODEL=base
CHATBOT_STT_LANGUAGE=vi
CHATBOT_PRODUCT_MAX_ROUNDS=2
CHATBOT_RERANK_CANDIDATES=30
CHATBOT_RERANK_BAYESIAN_PRIOR=20
CHATBOT_IMAGE_MODEL=openai/clip-vit-base-patch32
CHATBOT_IMAGE_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
CHATBOT_IMAGE_EMBED_URL=http://image-embedding:3022
CHATBOT_IMAGE_MIN_SCORE=0.65
CHATBOT_MODEL_TIMEOUT=120
CHATBOT_MIN_SCORE=0.35
CHATBOT_SIMILAR_MIN_SCORE=0.5
CHATBOT_POLICY_PDF_PATHS=/policies/shopee-help
CHATBOT_POLICY_MIN_SCORE=0.3
CHATBOT_POLICY_SYNC_SECONDS=86400
CHATBOT_POLICY_RETRY_SECONDS=60
CHATBOT_POLICY_EMBED_BATCH_SIZE=50
CHATBOT_POLICY_EMBED_RETRIES=10
CHATBOT_POLICY_EMBED_DELAY_SECONDS=0.5
CHATBOT_DATA_DIR=./data
CHATBOT_SYNC_SECONDS=300
QDRANT_URL=http://localhost:6333
PRODUCT_SERVICE_URL=http://localhost:3004
INVENTORY_SERVICE_URL=http://localhost:3007
# Comma-separated HTTPS hosts for external catalog images. Local product images
# are fetched through product-service with its public-base mapping automatically.
CHATBOT_IMAGE_HOSTS=
CHATBOT_EMBEDDING_DIMENSIONS=768
